# ============================================================
# Salin file ini menjadi `.env` lalu isi nilai aslinya:
#   cp .env.example .env
# Jangan pernah commit file .env ke git!
# ============================================================

# Profil tidak lagi diset di file ini. Gunakan --profile saat menjalankan compose:
#   docker compose --profile dev up -d    # pma/laravel hanya localhost
#   docker compose --profile prod up -d   # pma/laravel terbuka sesuai BIND_PROD

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change-me-strong-password
MYSQL_DATABASE=app_db
MYSQL_USER=app_user
MYSQL_PASSWORD=change-me-app-password

# Host yang diizinkan untuk login root. Biarkan "localhost" (aman).
# Isi dengan % hanya jika di dev Anda ingin login root lewat phpMyAdmin.
MYSQL_ROOT_HOST=localhost

# ---------- PostgreSQL ----------
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=app_db

# ---------- Alamat bind per profil ----------
# Tidak perlu mengubah IP saat pindah dev <-> prod:
#   - layanan profil dev memakai BIND_DEV
#   - layanan profil prod memakai BIND_PROD
# 127.0.0.1 = hanya dari mesin ini. 0.0.0.0 = semua interface (terbuka ke LAN).
BIND_DEV=127.0.0.1
BIND_PROD=0.0.0.0

# ---------- Laravel ----------
# APP_KEY dibuat lewat: docker compose exec laravel-app php artisan key:generate
APP_ENV=local
APP_DEBUG=true

# Alamat yang dipakai aplikasi Laravel (port 8000) untuk menerima koneksi.
# 127.0.0.1 = hanya dari mesin ini (aman untuk dev, default).
# Isi 0.0.0.0 atau IP LAN server hanya saat profil prod.
APP_BIND=127.0.0.1
